# Environment
# NODE_ENV deliberately omitted: the Django backend ignores it, `next dev`
# forces it to "development", and `next build` must run as "production".
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-1234567890

# Database
POSTGRES_DB=service_intel_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# API Configurations
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Frontend-only: route API calls to the in-repo BFF (src/app/api/) while the
# Django slices are unimplemented. Set to false once backend/features/* are live.
NEXT_PUBLIC_USE_DEV_BACKEND=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000